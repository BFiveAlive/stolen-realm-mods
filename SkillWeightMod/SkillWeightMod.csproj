<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SkillWeightMod</AssemblyName>
    <RootNamespace>SkillWeightMod</RootNamespace>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Description>Weights roguelike skill offers toward what your character already has.</Description>
    <!-- Data files shipped beside the DLL; the release script reads this. -->
    <ModDataFiles>skill-categories.json</ModDataFiles>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Unity/BepInEx assemblies are not signed/reference assemblies; silence the noise -->
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Override on the command line if Steam lives elsewhere:
       dotnet build -p:GameDir="D:\Games\Stolen Realm" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stolen Realm</GameDir>
    <ManagedDir>$(GameDir)\Stolen Realm_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginsDir>$(BepInExDir)\plugins\SkillWeightMod</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>$(ManagedDir)\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>$(ManagedDir)\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy straight into the game's plugin folder after every successful build -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <!-- The category map is data the plugin reads at runtime, so it ships beside the DLL. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\skill-categories.json"
          DestinationFolder="$(PluginsDir)"
          Condition="Exists('$(MSBuildProjectDirectory)\skill-categories.json')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PluginsDir)" />
  </Target>

</Project>
