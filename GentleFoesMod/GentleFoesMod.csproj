<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, NOT 2.0 - the game's Unity 2022.3 assemblies require it -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GentleFoesMod</AssemblyName>
    <RootNamespace>GentleFoesMod</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Swaps the look and name of animal enemies, for players who would rather not fight them.</Description>
    <!-- The swap list is the mod: without it the plugin loads and changes nothing. -->
    <ModDataFiles>swaps.default.json</ModDataFiles>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stolen Realm</GameDir>
    <ManagedDir>$(GameDir)\Stolen Realm_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginsDir>$(BepInExDir)\plugins\$(AssemblyName)</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Required by almost anything: the game's data classes derive from
         Odin's SerializedScriptableObject -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>$(ManagedDir)\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>$(ManagedDir)\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game ships Newtonsoft, which is what its own save files are written with. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <!-- The shipped swaps travel with the DLL: the mod's content, not its configuration.
         Edits live in BepInEx/config, where an update cannot reach them. -->
    <Copy SourceFiles="swaps.default.json" DestinationFolder="$(PluginsDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PluginsDir)" />
  </Target>

</Project>
