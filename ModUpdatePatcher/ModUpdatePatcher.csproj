<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModUpdatePatcher</AssemblyName>
    <RootNamespace>ModUpdatePatcher</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stolen Realm</GameDir>
    <ManagedDir>$(GameDir)\Stolen Realm_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <!-- Preloader patchers live here, not in plugins/. BepInEx runs them before the chainloader
         loads anything out of plugins/, which is the whole point of this assembly. -->
    <PatchersDir>$(BepInExDir)\patchers</PatchersDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only for the Patch(AssemblyDefinition) signature BepInEx scans for. Nothing is patched. -->
    <Reference Include="Mono.Cecil">
      <HintPath>$(BepInExDir)\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <HintPath>$(ManagedDir)\System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem">
      <HintPath>$(ManagedDir)\System.IO.Compression.FileSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(PatchersDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PatchersDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(PatchersDir)" />
  </Target>

</Project>
